# Database
DATABASE_URL=postgresql+asyncpg://realty_user:realty_password@localhost:5432/realty_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET_NAME=realty-platform-bucket
AWS_REGION=us-east-1

# API
API_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000/api

# Admin
ADMIN_EMAIL=admin@realty.uz
ADMIN_PASSWORD=admin123456

# Environment
ENVIRONMENT=development